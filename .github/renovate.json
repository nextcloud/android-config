{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "schedule:daily"
  ],
  "timezone": "Europe/Berlin",
  "labels": [
    "dependencies",
    "3. to review"
  ],
  "enabledManagers": [
    "github-actions"
  ],
  "github-actions": {
    "managerFilePatterns": [
      "/^(config\\/workflows)\\/[^/]+\\.ya?ml$/"
    ],
    "groupName": "actions"
  }
}
